  "launches": {"dev-env": {"apps": ["vscode"], "group": "coding"}},
  "layouts": {"two-columns": {"type": "grid", "columns": 2, "rows": 1}},
  "groups": {"coding": {"layout": "two-columns", "apps": ["vscode"], "onSwitchAway": "minimize"}}
}
"""

